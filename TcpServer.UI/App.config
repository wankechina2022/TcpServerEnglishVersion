<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- 以下均为只读运行参数，程序不会回写；业务配置请见 Config\portconfig.json -->
    <!-- 默认监听地址：127.0.0.1 仅本机可连；改为本机网卡地址或 0.0.0.0 可供外部设备连接 -->
    <add key="DefaultListenIp" value="127.0.0.1" />
    <!-- 默认起始端口 -->
    <add key="DefaultStartPort" value="60000" />
    <!-- 日志保留月数，超期自动删除 -->
    <add key="LogKeepMonths" value="6" />
    <!-- 接收缓冲区大小（字节） -->
    <add key="ReceiveBufferSize" value="8192" />
    <!-- 接收循环最小间隔（毫秒），用于降低数据粘连概率 -->
    <add key="IoMinIntervalMs" value="20" />
    <!-- 启动后是否自动开始监听，默认 false 避免误占端口 -->
    <add key="AutoStartOnLaunch" value="false" />
    <!-- TCP 保活：是否启用（2026-09-14 新增）。启用后客户端断电/拔线约 30 秒内自动清理会话，不影响长连接 -->
    <add key="KeepAliveEnabled" value="true" />
    <!-- TCP 保活：连接空闲多少秒后开始探测（默认 15）。注意这不是断开时间，对端在线则连接保持不动 -->
    <add key="KeepAliveIdleSeconds" value="15" />
    <!-- TCP 保活：两次探测的间隔秒数（默认 3） -->
    <add key="KeepAliveIntervalSeconds" value="3" />
    <!-- 发送超时毫秒数（2026-09-14 新增，默认 10000）。客户端连上后不读数据时，超时即放弃，避免界面卡死；0 表示不限（不推荐） -->
    <add key="SendTimeoutMs" value="10000" />
    <!-- 单个日志文件大小上限（字节，2026-09-14 新增，默认 20MB）。超限自动滚动为 _1/_2 分卷 -->
    <add key="LogMaxFileSizeBytes" value="20971520" />
    <!-- 日志异步写队列最大长度（2026-09-14 新增，默认 20000）。队列满时丢弃最旧日志，保护内存 -->
    <add key="LogQueueMaxLength" value="20000" />
    <!-- 配置备份 .bak 保留份数（2026-09-14 新增，默认 20）。每次保存配置都会备份，超量自动清理最旧的 -->
    <add key="ConfigBackupKeepCount" value="20" />
    <!-- 监听线程看门狗巡检间隔毫秒数（2026-09-14 新增，默认 5000）。Accept 线程意外死亡时自动重建监听；0 表示关闭 -->
    <add key="WatchdogIntervalMs" value="5000" />
    <!-- 日志定期清理的巡检间隔小时数（2026-09-14 新增，默认 24）。原先清理只在程序启动时执行一次，
         程序长期不关闭就永远不会清理；现由专职线程按本间隔周期清理超期日志。0 表示关闭定期清理 -->
    <add key="LogCleanupIntervalHours" value="24" />
  </appSettings>
  <!-- ============================================================================
       2026-09-14 撤销：WinForms 高 DPI 支持

       撤销原因：本机 150% 缩放（AppliedDPI=144）下声明 DPI 感知导致「界面变小 + 顶部工具栏
                 多处遮挡」。根因是 AutoScaleMode=Font 依赖的 Font.Height 在 .NET 中按 96 DPI
                 固定计算，高 DPI 下缩放因子仍为 1.0，控件不放大而字体会被 GDI+ 按 144 DPI 放大。
       详细分析与回退方式见 app.manifest 末尾说明。两者必须同时注释，缺一仍会触发该问题。

  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
       ============================================================================ -->
</configuration>
