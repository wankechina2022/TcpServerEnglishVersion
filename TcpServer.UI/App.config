<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- All entries below are read-only runtime parameters; the application never writes them back. -->
    <!-- Business configuration (ports, auto-reply rules) lives in Config\portconfig.json -->

    <!-- Default listen address. 127.0.0.1 accepts local connections only.
         Set it to a NIC address, or to 0.0.0.0, to accept connections from external devices. -->
    <add key="DefaultListenIp" value="127.0.0.1" />
    <!-- First port number used when ports are generated -->
    <add key="DefaultStartPort" value="60000" />
    <!-- Log retention in months. Files older than this are deleted automatically. -->
    <add key="LogKeepMonths" value="6" />
    <!-- Receive buffer size, in bytes -->
    <add key="ReceiveBufferSize" value="8192" />
    <!-- Minimum interval of the receive loop, in milliseconds. Lowers the chance of coalesced packets. -->
    <add key="IoMinIntervalMs" value="20" />
    <!-- Whether listening starts automatically on launch.
         Defaults to false so that ports are not occupied by accident. -->
    <add key="AutoStartOnLaunch" value="false" />
    <!-- TCP keep-alive: enable or disable (added 2026-09-14).
         When enabled, sessions of clients that lost power or were unplugged are cleaned up
         within about 30 seconds. Long-lived connections are not affected. -->
    <add key="KeepAliveEnabled" value="true" />
    <!-- TCP keep-alive: idle seconds before probing starts (default 15).
         This is NOT a disconnect timeout. If the peer is alive, the connection stays up. -->
    <add key="KeepAliveIdleSeconds" value="15" />
    <!-- TCP keep-alive: interval between two probes, in seconds (default 3) -->
    <add key="KeepAliveIntervalSeconds" value="3" />
    <!-- Send timeout in milliseconds (added 2026-09-14, default 10000).
         If a connected client never reads, the send is aborted on timeout so the UI cannot freeze.
         0 means no limit (not recommended). -->
    <add key="SendTimeoutMs" value="10000" />
    <!-- Maximum size of a single log file, in bytes (added 2026-09-14, default 20MB).
         Exceeding it rolls the file over into _1 / _2 volumes. -->
    <add key="LogMaxFileSizeBytes" value="20971520" />
    <!-- Maximum length of the asynchronous log queue (added 2026-09-14, default 20000).
         When the queue is full the oldest entries are dropped to protect memory. -->
    <add key="LogQueueMaxLength" value="20000" />
    <!-- Number of .bak configuration backups to keep (added 2026-09-14, default 20).
         Every save creates a backup; the oldest ones are removed once the limit is exceeded. -->
    <add key="ConfigBackupKeepCount" value="20" />
    <!-- Watchdog interval for the listener thread, in milliseconds (added 2026-09-14, default 5000).
         Listening is rebuilt automatically if the Accept thread dies unexpectedly. 0 disables it. -->
    <add key="WatchdogIntervalMs" value="5000" />
    <!-- Interval in hours for periodic log cleanup (added 2026-09-14, default 24).
         Cleanup used to run only once at startup, so a process left running for weeks
         never cleaned anything. A dedicated thread now cleans expired logs on this interval.
         0 disables periodic cleanup. -->
    <add key="LogCleanupIntervalHours" value="24" />
  </appSettings>
  <!-- ============================================================================
       2026-09-14 REVERTED: WinForms high-DPI support

       Reason for reverting: at 150% scaling (AppliedDPI = 144), declaring DPI awareness
       made the whole UI shrink and clipped several controls on the top toolbar.
       Root cause: AutoScaleMode=Font derives its scale factor from Font.Height, which .NET
       always computes at 96 DPI, so the factor stays 1.0 and controls are never enlarged,
       while GDI+ still renders text at 144 DPI.

       See the notes at the end of app.manifest for the full analysis and the rollback steps.
       Both places must stay commented out; leaving either one active reintroduces the problem.

  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
       ============================================================================ -->
</configuration>
